// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider  = "prisma-client"
  output    = "../generated/prisma"
  transpile = true
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  subscription Subscription?
  sessions     Session[]
  watchHistory WatchHistory[]
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique
  plan   Plan   @relation(fields: [planId], references: [id])

  user   User @relation(fields: [userId], references: [id])
  planId Int
}

model Plan {
  id         Int      @id @default(autoincrement())
  type       PlanType @unique
  maxDevices Int

  subscriptions Subscription[]
  contentAccess ContentAccess[]
}

enum PlanType {
  FREE
  BASIC
  PREMIUM
  ULTRA_PREMIUM
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  deviceId         String
  deviceName       String?
  refreshTokenHash String
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@index([userId])
}

// OTT Content Models
model Content {
  id          String      @id @default(uuid())
  title       String
  description String
  poster      String? // URL to poster image
  thumbnail   String? // URL to thumbnail
  duration    Int? // Duration in minutes (for movies/episodes)
  releaseDate DateTime
  rating      String? // Content rating (U, UA, A, S, etc.)
  contentType ContentType // MOVIE, SERIES, DOCUMENTARY, etc.
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relationships
  genres       ContentGenre[]
  access       ContentAccess[]
  watchHistory WatchHistory[]

  @@index([contentType])
  @@index([releaseDate])
}

enum ContentType {
  MOVIE
  SERIES
  DOCUMENTARY
  SHOW
  SPORTS
  KIDS
}

model Genre {
  id       String         @id @default(uuid())
  name     String         @unique
  contents ContentGenre[]
}

model ContentGenre {
  id        String  @id @default(uuid())
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId   String

  @@unique([contentId, genreId])
  @@index([genreId])
}

// Plan-aware content access control
model ContentAccess {
  id           String       @id @default(uuid())
  content      Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId    String
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId       Int
  videoQuality VideoQuality // Quality available for this plan (SD, HD, 4K, etc.)
  createdAt    DateTime     @default(now())

  @@unique([contentId, planId])
  @@index([planId])
}

enum VideoQuality {
  SD // 480p
  HD // 720p
  FHD // 1080p
  UHD // 4K
}

// Watch history for user tracking
model WatchHistory {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String
  watchedAt DateTime @default(now())
  progress  Int? // Progress in seconds (for resuming)
  completed Boolean  @default(false)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}
