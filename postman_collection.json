                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "auth", "register"]
                        },
                        "description": "Register a new user. Password must contain uppercase, lowercase, number, and special character."
                    },
                    "response": []
                },
                {
                    "name": "Login - WEB",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    pm.environment.set('accessToken', response.data.session.accessToken);",
                                    "    pm.environment.set('userId', response.data.user.id);",
                                    "    pm.environment.set('sessionId', response.data.session.id);",
                                    "    pm.environment.set('deviceId', response.data.session.deviceId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "id": "f2fa11f2-45e8-405e-a688-0a2667092d51",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"deviceId\": \"{{uuidv4}}\",\n  \"deviceType\": \"WEB\",\n  \"deviceName\": \"Chrome Browser\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "auth", "login"]
                        },
                        "description": "Login for WEB devices. RefreshToken sent in httpOnly cookie."
                    },
                    "response": []
                },
                {
                    "name": "Login - ANDROID/IOS",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    pm.environment.set('accessToken', response.data.session.accessToken);",
                                    "    pm.environment.set('refreshToken', response.data.session.refreshToken);",
                                    "    pm.environment.set('userId', response.data.user.id);",
                                    "    pm.environment.set('sessionId', response.data.session.id);",
                                    "    pm.environment.set('deviceId', response.data.session.deviceId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
